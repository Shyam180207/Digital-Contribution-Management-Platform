meta {
  name: Get session and CSRF token
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/auth/session
  body: none
  auth: none
}

script:post-response {
  const body = res.getBody();
  if (body?.csrfToken) bru.setEnvVar("csrfToken", body.csrfToken);
}

docs {
  Returns the signed-in user, if any, and a CSRF token. Bruno keeps the cookies from this response and stores the token for subsequent state-changing requests.
}
